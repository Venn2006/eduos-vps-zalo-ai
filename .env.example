# PostgreSQL
DATABASE_URL="postgresql://eduos:password@localhost:5432/eduos_zalo_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Shared web rate limit store (recommended for staging/production multi-instance deploys)
# When these are absent, the web app falls back to local in-memory rate limits for dev only.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# ALLOW_IN_MEMORY_RATE_LIMITS=false

# Audit log governance
AUDIT_LOG_RETENTION_DAYS=180

# API & Worker
PORT=3001
JWT_SECRET="super-secret-jwt-key"

# Zalo Connector
CLOUD_API_URL="http://localhost:3001"
CONNECTOR_TOKEN="secret-connector-auth-token"
CONNECTOR_ACCOUNT_ID="tenant_0_omlis"
POLL_INTERVAL_SECONDS=10
MOCK_MODE=true

# AI Providers (Mock by default)
AI_PROVIDER="mock"
# OPENAI_API_KEY=""
# DEEPSEEK_API_KEY=""

# Facebook Meta
# FB_APP_SECRET=""
# FB_VERIFY_TOKEN=""
# FB_PAGE_ACCESS_TOKEN=""
# Local dev only: allow Facebook webhook POST without x-hub-signature-256 when FB_APP_SECRET is unset.
# ALLOW_UNSIGNED_FACEBOOK_WEBHOOK=false

# Billing pilot payment display (leave blank to require manual admin contact)
# BILLING_BANK_NAME=""
# BILLING_BANK_ACCOUNT_NUMBER=""
# BILLING_BANK_ACCOUNT_HOLDER=""
# BILLING_QR_IMAGE_URL=""
